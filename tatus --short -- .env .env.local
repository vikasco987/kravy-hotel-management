[32m+[m[32m      <div className="px-6 py-5 border-b border-[var(--kravy-border)] bg-[var(--kravy-bg-2)]/50">[m
[32m+[m[32m        <h3 className="text-base font-black text-[var(--kravy-text-primary)] tracking-tight">Hotel Folio Preview</h3>[m
[32m+[m[32m        <p className="text-[10px] font-bold text-[var(--kravy-text-muted)] uppercase tracking-wider mt-0.5">Live Guest Invoice Rendering</p>[m
[32m+[m[32m      </div>[m
[32m+[m[32m      <div className="p-8 bg-[#E5E5E5] dark:bg-[#1A1A1A] flex justify-center min-h-[500px]">[m
[32m+[m[32m        <div[m
