[32m+[m[32m        <Field label="Front Desk / Manager Name" error={errors.contactName?.message}>[m
[32m+[m[32m          <Input {...register("contactName")} placeholder="Full Name" className="h-11 rounded-xl bg-[var(--kravy-input-bg)] border-[var(--kravy-input-border)] text-[var(--kravy-text-primary)]" />[m
[32m+[m[32m        </Field>[m
[32m+[m
[32m+[m[32m        <Field label="Front Desk Phone" error={errors.contactPhone?.message}>[m
