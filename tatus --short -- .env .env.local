[32m+[m[32m"use client";[m
[32m+[m
[32m+[m[32mimport { useState, useEffect } from "react";[m
[32m+[m[32mimport { useRouter } from "next/navigation";[m
[32m+[m[32mimport { useForm } from "react-hook-form";[m
[32m+[m[32mimport { zodResolver } from "@hookform/resolvers/zod";[m
[32m+[m[32mimport { z } from "zod";[m
[32m+[m[32mimport { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";[m
[32m+[m[32mimport { Button } from "@/components/ui/button";[m
[32m+[m[32mimport { toast } from "sonner";[m
[32m+[m[32mimport { Input } from "@/components/ui/input";[m
[32m+[m[32mimport { Label } from "@/components/ui/label";[m
[32m+[m[32mimport { Plus, Upload, Download, FileJson, ClipboardPaste, Info, AlertCircle, Sparkles, X } from "lucide-react";[m
[32m+[m[32mimport {[m
[32m+[m[32m  Sheet,[m
[32m+[m[32m  SheetContent,[m
[32m+[m[32m  SheetHeader,[m
[32m+[m[32m  SheetTitle,[m
[32m+[m[32m  SheetTrigger,[m
[32m+[m[32m  SheetDescription,[m
[32m+[m[32m} from "@/components/ui/sheet";[m
[32m+[m[32mimport { Textarea } from "@/components/ui/textarea";[m
[32m+[m[32mimport { uploadToCloudinary } from "@/lib/cloudinary-client";[m
[32m+[m[32mimport { INDIA_STATE_DISTRICT } from "@/lib/india-state-district";[m
[32m+[m[32mimport { notifyProfileUpdated } from "@/hooks/useProfileCache";[m
[32m+[m
[32m+[m
[32m+[m[32m/* ---------------- SCHEMA ---------------- */[m
[32m+[m[32mconst GSTIN_REGEX = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/;[m
[32m+[m[32mconst PINCODE_REGEX = /^[1-9][0-9]{5}$/;[m
[32m+[m[32mconst PHONE_REGEX = /^(?:\+91|91)?[6-9]\d{9}$/;[m
[32m+[m
[32m+[m[32mconst schema = z.object({[m
[32m+[m[32m  id: z.string().optional(),[m
[32m+[m[32m  businessType: z.string().nullable().optional(),[m
[32m+[m[32m  businessName: z.string().min(1, "Business name is required"),[m
[32m+[m[32m  businessTagline: z.string().nullable().optional(),[m
[32m+[m
[32m+[m[32m  contactName: z.string().nullable().optional(),[m
[32m+[m[32m  contactPhone: z[m
[32m+[m[32m    .string()[m
[32m+[m[32m    .nullable()[m
[32m+[m[32m    .optional()[m
[32m+[m[32m    .refine((val) => {[m
[32m+[m[32m      if (!val || val.trim() === '') return true;[m
[32m+[m[32m      const cleaned = val.replace(/[\s\-()]/g, '');[m
[32m+[m[32m      return PHONE_REGEX.test(cleaned) || /^\d{10,12}$/.test(cleaned);[m
[32m+[m[32m    }, { message: "Invalid 10-digit mobile number" }),[m
[32m+[m[32m  contactEmail: z.string().email("Invalid email format").or(z.literal('')).nullable().optional(),[m
[32m+[m
[32m+[m[32m  upi: z.string().nullable().optional(),[m
[32m+[m[32m  gstNumber: z[m
[32m+[m[32m    .string()[m
[32m+[m[32m    .nullable()[m
[32m+[m[32m    .optional()[m
[32m+[m[32m    .refine((val) => {[m
[32m+[m[32m      if (!val || val.trim() === '') return true;[m
[32m+[m[32m      return GSTIN_REGEX.test(val.trim().toUpperCase());[m
[32m+[m[32m    }, { message: "Invalid GSTIN format (e.g. 07AAAAA0000A1Z5)" }),[m
[32m+[m
[32m+[m[32m  businessAddress: z.string().nullable().optional(),[m
[32m+[m[32m  state: z.string().nullable().optional(),[m
[32m+[m[32m  district: z.string().nullable().optional(),[m
[32m+[m[32m  pinCode: z[m
[32m+[m[32m    .string()[m
[32m+[m[32m    .nullable()[m
[32m+[m[32m    .optional()[m
[32m+[m[32m    .refine((val) => {[m
[32m+[m[32m      if (!val || val.trim() === '') return true;[m
[32m+[m[32m      return PINCODE_REGEX.test(val.trim());[m
[32m+[m[32m    }, { message: "PIN code must be exactly 6 digits" }),[m
[32m+[m
[32m+[m[32m  upiQrEnabled: z.boolean().nullable().optional(),[m
[32m+[m[32m  greetingMessage: z.string().nullable().optional(),[m
[32m+[m
[32m+[m[32m  // Optional legacy fields preserved for payload compatibility[m
[32m+[m[32m  menuLinkEnabled: z.boolean().nullable().optional(),[m
[32m+[m[32m  businessNameSize: z.string().nullable().optional(),[m
[32m+[m[32m  fssaiNumber: z.string().nullable().optional(),[m
[32m+[m[32m  fssaiEnabled: z.boolean().nullable().optional(),[m
[32m+[m[32m  hsnEnabled: z.boolean().nullable().optional(),[m
[32m+[m[32m  enableMenuQRInBill: z.boolean().nullable().optional(),[m
[32m+[m[32m  enableClerkAuth: z.boolean().nullable().optional(),[m
[32m+[m[32m  enableCustomAuth: z.boolean().nullable().optional(),[m
[32m+[m[32m  tokenNumberSize: z.number().nullable().optional(),[m
[32m+[m[32m  businessAddressSize: z.number().nullable().optional(),[m
[32m+[m[32m  phonePrefixType: z.string().nullable().optional(),[m
[32m+[m[32m});[m
[32m+[m
[32m+[m[32mtype FormValues = z.infer<typeof schema>;[m
[32m+[m
[32m+[m[32mexport default function BusinessProfileForm({[m
[32m+[m[32m  mode,[m
[32m+[m[32m  defaultValues,[m
[32m+[m[32m  onCancel,[m
[32m+[m[32m  onSuccess,[m
[32m+[m[32m}: {[m
[32m+[m[32m  mode: "create" | "edit";[m
[32m+[m[32m  defaultValues?: Partial<FormValues> & {[m
[32m+[m[32m    profileImageUrl?: string;[m
[32m+[m[32m    logoUrl?: string;[m
[32m+[m[32m    signatureUrl?: string;[m
[32m+[m[32m    upiQrEnabled?: boolean;[m
[32m+[m[32m    userId?: string;[m
[32m+[m[32m    id?: string;[m
[32m+[m[32m  };[m
[32m+[m[32m  onCancel?: () => void;[m
[32m+[m[32m  onSuccess?: () => void;[m
[32m+[m[32m}) {[m
[32m+[m
[32m+[m[32m  const router = useRouter();[m
[32m+[m[32m  const [loading, setLoading] = useState(false);[m
[32m+[m[32m  const [selectedState, setSelectedState] = useState(defaultValues?.state || "");[m
[32m+[m[32m  const [pastedJson, setPastedJson] = useState("");[m
[32m+[m[32m  const [isPasteModalOpen, setIsPasteModalOpen] = useState(false);[m
[32m+[m
[32m+[m
[32m+[m[32m  const [profilePreview, setProfilePreview] = useState<string | null>([m
[32m+[m[32m    defaultValues?.profileImageUrl || null[m
[32m+[m[32m  );[m
[32m+[m[32m  const [logoPreview, setLogoPreview] = useState<string | null>([m
[32m+[m[32m    defaultValues?.logoUrl || null[m
[32m+[m[32m  );[m
[32m+[m[32m  const [signaturePreview, setSignaturePreview] = useState<string | null>([m
[32m+[m[32m    defaultValues?.signatureUrl || null[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  const initialValues: Partial<FormValues> = {[m
[32m+[m[32m    ...defaultValues,[m
[32m+[m[32m    businessType: defaultValues?.businessType || (mode === "create" ? "Hotel" : ""),[m
[32m+[m[32m    greetingMessage: defaultValues?.greetingMessage ?? "Thank you for staying with us!",[m
[32m+[m[32m    upiQrEnabled: defaultValues?.upiQrEnabled ?? true,[m
[32m+[m[32m  };[m
[32m+[m
[32m+[m[32m  const { register, handleSubmit, watch, reset, setValue, formState: { errors } } = useForm<FormValues>({[m
[32m+[m[32m    resolver: zodResolver(schema),[m
[32m+[m[32m    defaultValues: initialValues,[m
[32m+[m[32m  });[m
[32m+[m
[32m+[m[32m  const currentPinCode = watch("pinCode");[m
[32m+[m
[32m+[m[32m  useEffect(() => {[m
[32m+[m[32m    if (currentPinCode && currentPinCode.length === 6 && /^\d+$/.test(currentPinCode)) {[m
[32m+[m[32m      fetch(`https://api.postalpincode.in/pincode/${currentPinCode}`)[m
[32m+[m[32m        .then((res) => res.json())[m
[32m+[m[32m        .then((data) => {[m
[32m+[m[32m          if (data && data[0]?.Status === "Success" && data[0]?.PostOffice?.length > 0) {[m
[32m+[m[32m            const postOffice = data[0].PostOffice[0];[m
[32m+[m[32m            const fetchedState = postOffice.State;[m
[32m+[m[32m            let fetchedDistrict = postOffice.District.replace(/ district$/i, '').trim();[m
[32m+[m
[32m+[m[32m            // Fuzzy match the State[m
[32m+[m[32m            const stateKeys = Object.keys(INDIA_STATE_DISTRICT);[m
[32m+[m[32m            const matchedState = stateKeys.find(s => s.toLowerCase() === fetchedState.toLowerCase()) || fetchedState;[m
[32m+[m
[32m+[m[32m            setSelectedState(matchedState);[m
[32m+[m[32m            setValue("state", matchedState, { shouldValidate: true });[m
[32m+[m
[32m+[m[32m            // Wait for re-render so district options are populated before setting value[m
[32m+[m[32m            setTimeout(() => {[m
[32m+[m[32m              const districts = INDIA_STATE_DISTRICT[matchedState] || [];[m
[32m+[m[32m              const matchedDistrict = districts.find(d => d.toLowerCase() === fetchedDistrict.toLowerCase()) || fetchedDistrict;[m
[32m+[m[32m              setValue("district", matchedDistrict, { shouldValidate: true });[m
[32m+[m[32m              toast.success("State & District auto-filled from PIN Code!");[m
[32m+[m[32m            }, 100);[m
[32m+[m[32m          }[m
[32m+[m[32m        })[m
[32m+[m[32m        .catch((err) => console.error("Failed to fetch pin code details", err));[m
[32m+[m[32m    }[m
[32m+[m[32m  }, [currentPinCode, setValue]);[m
[32m+[m
[32m+[m[32m  const handleSchemaUpload = (e: React.ChangeEvent<HTMLInputElement>) => {[m
[32m+[m[32m    const file = e.target.files?.[0];[m
[32m+[m[32m    if (!file) return;[m
[32m+[m[32m    const reader = new FileReader();[m
[32m+[m[32m    reader.onload = (event) => applyJsonToForm(event.target?.result as string);[m
[32m+[m[32m    reader.readAsText(file);[m
[32m+[m[32m  };[m
[32m+[m
[32m+[m[32m  const applyJsonToForm = async (jsonStr: string) => {[m
[32m+[m[32m    try {[m
[32m+[m[32m      const json = JSON.parse(jsonStr);[m
[32m+[m[32m      setLoading(true);[m
[32m+[m
[32m+[m[32m      // 1. Merge pasted JSON with current payload structure[m
[32m+[m[32m      // This ensures both 'contactName' and 'contactPersonName' style keys work[m
[32m+[m[32m      const payload = {[m
[32m+[m[32m        ...json, // Spread everything from the pasted JSON[m
[32m+[m
[32m+[m[32m        // Ensure standard keys exist (API will prioritize these if available)[m
[32m+[m[32m        businessType: json.businessType ?? defaultValues?.businessType,[m
[32m+[m[32m        businessName: json.businessName ?? defaultValues?.businessName,[m
[32m+[m[32m        businessTagline: json.businessTagline ?? json.businessTagLine ?? defaultValues?.businessTagline,[m
[32m+[m
[32m+[m[32m        contactName: json.contactName ?? json.contactPersonName,[m
[32m+[m[32m        contactPhone: json.contactPhone ?? json.contactPersonPhone,[m
[32m+[m[32m        contactEmail: json.contactEmail ?? json.contactPersonEmail,[m
[32m+[m
[32m+[m[32m        upi: json.upi ?? defaultValues?.upi,[m
[32m+[m
[32m+[m[32m        profileImage: json.profileImageUrl ?? json.profileImage ?? defaultValues?.profileImageUrl,[m
[32m+[m[32m        logo: json.logoUrl ?? json.logo ?? defaultValues?.logoUrl,[m
[32m+[m[32m        signature: json.signatureUrl ?? json.signature ?? defaultValues?.signatureUrl,[m
[32m+[m
[32m+[m[32m        gstNumber: json.gstNumber ?? defaultValues?.gstNumber,[m
[32m+[m[32m        businessAddress: json.businessAddress ?? defaultValues?.businessAddress,[m
[32m+[m[32m        state: json.state ?? defaultValues?.state,[m
[32m+[m[32m        district: json.district ?? defaultValues?.district,[m
[32m+[m[32m        pinCode: json.pinCode ?? defaultValues?.pinCode,[m
[32m+[m[32m        greetingMessage: json.greetingMessage ?? defaultValues?.greetingMessage ?? "Thank you for staying with us!",[m
[32m+[m[32m        upiQrEnabled: json.upiQrEnabled ?? defaultValues?.upiQrEnabled ?? true,[m
[32m+[m[32m      };[m
[32m+[m
[32m+[m[32m      // 2. Direct POST to API[m
[32m+[m[32m      const res = await fetch("/api/profile", {[m
[32m+[m[32m        method: "POST",[m
[32m+[m[32m        headers: { "Content-Type": "application/json" },[m
[32m+[m[32m        body: JSON.stringify(payload),[m
[32m+[m[32m      });[m
[32m+[m
[32m+[m[32m      if (!res.ok) throw new Error("API Save Failed");[m
[32m+[m
[32m+[m[32m      // 3. UI Update (Success)[m
[32m+[m[32m      reset(json);[m
[32m+[m[32m      if (json.profileImageUrl || json.profileImage) setProfilePreview(json.profileImageUrl || json.profileImage);[m
[32m+[m[32m      if (json.logoUrl || json.logo) setLogoPreview(json.logoUrl || json.logo);[m
[32m+[m[32m      if (json.signatureUrl || json.signature) setSignaturePreview(json.signatureUrl || json.signature);[m
[32m+[m[32m      if (json.state) setSelectedState(json.state);[m
[32m+[m
[32m+[m[32m      alert("Schema applied and profile updated successfully! 🎉");[m
[32m+[m[32m      setIsPasteModalOpen(false);[m
[32m+[m[32m      notifyProfileUpdated(json);[m
[32m+[m[32m      if (onSuccess) onSuccess();[m
[32m+[m
[32m+[m[32m    } catch (err) {[m
[32m+[m[32m      alert("Error: Schema format invalid or connection issue.");[m
[32m+[m[32m    } finally {[m
[32m+[m[32m      setLoading(false);[m
[32m+[m[32m    }[m
[32m+[m[32m  };[m
[32m+[m
[32m+[m[32m  const handleDownloadSchema = () => {[m
[32m+[m[32m    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(watchedValues, null, 2));[m
[32m+[m[32m    const downloadAnchorNode = document.createElement('a');[m
[32m+[m[32m    downloadAnchorNode.setAttribute("href", dataStr);[m
[32m+[m[32m    downloadAnchorNode.setAttribute("download", "business_profile_schema.json");[m
[32m+[m[32m    document.body.appendChild(downloadAnchorNode);[m
[32m+[m[32m    downloadAnchorNode.click();[m
[32m+[m[32m    downloadAnchorNode.remove();[m
[32m+[m[32m  };[m
[32m+[m
[32m+[m[32m  const watchedValues = watch();[m
[32m+[m
[32m+[m[32m  async function onSubmit(values: FormValues) {[m
[32m+[m[32m    setLoading(true);[m
[32m+[m
[32m+[m[32m    try {[m
[32m+[m[32m      const getFile = (id: string) =>[m
[32m+[m[32m        (document.getElementById(id) as HTMLInputElement)?.files?.[0];[m
[32m+[m
[32m+[m[32m      let profileImageUrl = defaultValues?.profileImageUrl || null;[m
[32m+[m[32m      const profileImageFile = getFile("profileImage");[m
[32m+[m[32m      if (profileImageFile) {[m
[32m+[m[32m        try {[m
[32m+[m[32m          profileImageUrl = await uploadToCloudinary(profileImageFile);[m
[32m+[m[32m        } catch (uploadErr: any) {[m
[32m+[m[32m          console.error("Profile image upload failed:", uploadErr);[m
[32m+[m[32m          toast.error(uploadErr.message || "Profile image upload failed.");[m
[32m+[m[32m          return;[m
[32m+[m[32m        }[m
[32m+[m[32m      }[m
[32m+[m
[32m+[m[32m      let logoUrl = defaultValues?.logoUrl || null;[m
[32m+[m[32m      const logoFile = getFile("logo");[m
[32m+[m[32m      if (logoFile) {[m
[32m+[m[32m        try {[m
[32m+[m[32m          logoUrl = await uploadToCloudinary(logoFile);[m
[32m+[m[32m        } catch (uploadErr: any) {[m
[32m+[m[32m          console.error("Logo upload failed:", uploadErr);[m
[32m+[m[32m          toast.error(uploadErr.message || "Logo upload failed.");[m
[32m+[m[32m          return;[m
[32m+[m[32m        }[m
[32m+[m[32m      }[m
[32m+[m
[32m+[m[32m      let signatureUrl = defaultValues?.signatureUrl || null;[m
[32m+[m[32m      const signatureFile = getFile("signature");[m
[32m+[m[32m      if (signatureFile) {[m
[32m+[m[32m        try {[m
[32m+[m[32m          signatureUrl = await uploadToCloudinary(signatureFile);[m
[32m+[m[32m        } catch (uploadErr: any) {[m
[32m+[m[32m          console.error("Signature upload failed:", uploadErr);[m
[32m+[m[32m          toast.error(uploadErr.message || "Signature upload failed.");[m
[32m+[m[32m          return;[m
[32m+[m[32m        }[m
[32m+[m[32m      }[m
[32m+[m
[32m+[m[32m      // ✅ EXPLICIT PAYLOAD (MATCHES API 1:1)[m
[32m+[m[32m      const payload = {[m
[32m+[m[32m        id: defaultValues?.id,[m
[32m+[m[32m        isNewProfile: mode === "create",[m
[32m+[m[32m        businessType: values.businessType || "Hotel",[m
[32m+[m[32m        businessName: values.businessName,[m
[32m+[m[32m        businessTagline: values.businessTagline || null,[m
[32m+[m
[32m+[m[32m        contactName: values.contactName || null,[m
[32m+[m[32m        contactPhone: values.contactPhone || null,[m
[32m+[m[32m        contactEmail: values.contactEmail || null,[m
[32m+[m
[32m+[m[32m        upi: values.upi || null,[m
[32m+[m
[32m+[m[32m        profileImage: profileImageUrl,[m
[32m+[m[32m        logo: logoUrl,[m
[32m+[m[32m        signature: signatureUrl,[m
[32m+[m
[32m+[m[32m        gstNumber: values.gstNumber ? values.gstNumber.trim().toUpperCase() : null,[m
[32m+[m[32m        businessAddress: values.businessAddress || null,[m
[32m+[m[32m        state: values.state || null,[m
[32m+[m[32m        district: values.district || null,[m
[32m+[m[32m        pinCode: values.pinCode ? values.pinCode.trim() : null,[m
[32m+[m
[32m+[m[32m        upiQrEnabled: values.upiQrEnabled ?? true,[m
[32m+[m[32m        greetingMessage: values.greetingMessage || "Thank you for staying with us!",[m
[32m+[m[32m      };[m
[32m+[m
[32m+[m[32m      const res = await fetch("/api/profile", {[m
[32m+[m[32m        method: "POST",[m
[32m+[m[32m        headers: { "Content-Type": "application/json" },[m
[32m+[m[32m        body: JSON.stringify(payload),[m
[32m+[m[32m      });[m
[32m+[m
[32m+[m[32m      if (!res.ok) {[m
[32m+[m[32m        const status = res.status;[m
[32m+[m[32m        const text = await res.text().catch(() => "No response text");[m
[32m+[m[32m        console.error(`Save failed (${status}):`, text);[m
[32m+[m
[32m+[m[32m        let errorMsg = "Unknown Server Error";[m
[32m+[m[32m        try {[m
[32m+[m[32m          const errData = JSON.parse(text);[m
[32m+[m[32m          errorMsg = errData.details || errData.error || errorMsg;[m
[32m+[m[32m        } catch (e) {}[m
[32m+[m
[32m+[m[32m        toast.error(`Failed to save profile: ${errorMsg}`);[m
[32m+[m[32m        return;[m
[32m+[m[32m      }[m
[32m+[m
[32m+[m[32m      const savedData = await res.json();[m
[32m+[m[32m      console.log("Profile Saved Successfully:", savedData);[m
[32m+[m
[32m+[m[32m      toast.success("Business profile saved successfully!");[m
[32m+[m
[32m+[m[32m      // Dispatch event to refresh GlobalHeader, Sidebar, RoomDashboard etc.[m
[32m+[m[32m      notifyProfileUpdated(savedData);[m
[32m+[m
[32m+[m[32m      // ✅ SUCCESS[m
[32m+[m[32m      if (onSuccess) {[m
[32m+[m[32m        onSuccess();[m
[32m+[m[32m      }[m
[32m+[m
[32m+[m[32m    } catch (err: any) {[m
[32m+[m[32m      console.error("Submit error:", err);[m
[32m+[m[32m      toast.error(err?.message || "Something went wrong while saving your profile. Please check your connection.");[m
[32m+[m[32m    } finally {[m
[32m+[m[32m      setLoading(false);[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m
[32m+[m[32m  return ([m
[32m+[m[32m    <div className="flex flex-col xl:flex-row gap-6 max-w-[1400px] mx-auto p-6 items-start">[m
[32m+[m[32m      <form[m
[32m+[m[32m        onSubmit={handleSubmit(onSubmit, (errors) => {[m
[32m+[m[32m          console.group("🚫 Validation Errors Details");[m
[32m+[m[32m          console.error("Full Errors Object:", errors);[m
[32m+[m[32m          Object.keys(errors).forEach(key => {[m
[32m+[m[32m            console.error(`Field "${key}":`, errors[key as keyof typeof errors]);[m
[32m+[m[32m          });[m
[32m+[m[32m          console.groupEnd();[m
[32m+[m[32m          toast.error("Please fix the validation errors in the form");[m
[32m+[m[32m        })}[m
[32m+[m[32m        className="flex-1 w-full space-y-8 animate-in fade-in slide-in-from-bottom-4 transition-colors"[m
[32m+[m[32m      >[m
[32m+[m[32m      {/* SCHEMA ACTIONS */}[m
[32m+[m[32m      <div className="flex flex-col gap-6 bg-[var(--kravy-surface)] p-6 rounded-[32px] border border-[var(--kravy-border)] shadow-xl relative overflow-hidden">[m
[32m+[m[32m        <div className="absolute top-0 right-0 p-8 opacity-5 pointer-events-none">[m
[32m+[m[32m          <FileJson size={120} />[m
[32m+[m[32m        </div>[m
[32m+[m
[32m+[m[32m        <div className="flex flex-col gap-2">[m
[32m+[m[32m          <h3 className="text-xl font-black text-[var(--kravy-text-primary)] flex items-center gap-2 tracking-tight">[m
[32m+[m[32m            <Sparkles className="text-indigo-500" size={20} />[m
[32m+[m[32m            Schema Management[m
[32m+[m[32m          </h3>[m
[32m+[m[32m          <p className="text-xs font-bold text-[var(--kravy-text-muted)] uppercase tracking-widest">Bulk Setup via JSON Schema</p>[m
[32m+[m[32m        </div>[m
[32m+[m
[32m+[m[32m        <div className="flex flex-wrap gap-4">[m
[32m+[m[32m          <label className="flex items-center gap-3 px-6 py-3 bg-indigo-500 text-white rounded-2xl cursor-pointer hover:bg-indigo-600 transition-all text-[11px] font-black uppercase tracking-widest shadow-lg shadow-indigo-500/20 active:scale-95 group">[m
[32m+[m[32m            <Upload size={16} className="group-hover:-translate-y-0.5 transition-transform" />[m
[32m+[m[32m            Upload JSON File[m
[32m+[m[32m            <input type="file" accept=".json" hidden onChange={handleSchemaUpload} />[m
[32m+[m[32m          </label>[m
[32m+[m
[32m+[m[32m          <Sheet open={isPasteModalOpen} onOpenChange={setIsPasteModalOpen}>[m
[32m+[m[32m            <SheetTrigger asChild>[m
[32m+[m[32m              <button[m
[32m+[m[32m                type="button"[m
[32m+[m[32m                className="flex items-center gap-3 px-6 py-3 bg-[var(--kravy-bg-2)] text-[var(--kravy-text-primary)] rounded-2xl hover:border-indigo-500/50 border border-[var(--kravy-border)] transition-all text-[11px] font-black uppercase tracking-widest active:scale-95"[m
[32m+[m[32m              >[m
[32m+[m[32m                <ClipboardPaste size={16} />[m
[32m+[m[32m                Paste Schema Text[m
[32m+[m[32m              </button>[m
[32m+[m[32m            </SheetTrigger>[m
[32m+[m[32m            <SheetContent className="sm:max-w-xl bg-[var(--kravy-surface)] border-[var(--kravy-border)] p-8 overflow-y-auto">[m
[32m+[m[32m              <SheetHeader>[m
[32m+[m[32m                <SheetTitle className="text-2xl font-black text-[var(--kravy-text-primary)] tracking-tight">Paste Business Schema</SheetTitle>[m
[32m+[m[32m                <SheetDescription className="text-sm font-bold text-[var(--kravy-text-muted)]">Paste your business configuration JSON below to auto-fill the form</SheetDescription>[m
[32m+[m[32m              </SheetHeader>[m
[32m+[m[32m              <div className="mt-8 space-y-6">[m
[32m+[m[32m                <Textarea[m
[32m+[m[32m                  placeholder='{ "businessName": "My Awesome Store", ... }'[m
[32m+[m[32m                  className="min-h-[400px] font-mono text-xs bg-[var(--kravy-bg-2)] border-[var(--kravy-border)] rounded-2xl p-6 focus:ring-2 focus:ring-indigo-500/20 transition-all text-[var(--kravy-text-primary)]"[m
[32m+[m[32m                  value={pastedJson}[m
[32m+[m[32m                  onChange={(e) => setPastedJson(e.target.value)}[m
[32m+[m[32m                />[m
[32m+[m[32m                <div className="flex flex-col gap-3">[m
[32m+[m[32m                  <Button className="w-full bg-indigo-500 text-white font-black py-4 rounded-xl" onClick={() => applyJsonToForm(pastedJson)}>Apply Schema Data</Button>[m
[32m+[m[32m                  <Button variant="ghost" className="w-full" onClick={() => setIsPasteModalOpen(false)}>Close & Reset</Button>[m
[32m+[m[32m                </div>[m
[32m+[m[32m              </div>[m
[32m+[m[32m            </SheetContent>[m
[32m+[m[32m          </Sheet>[m
[32m+[m
[32m+[m[32m          <button[m
[32m+[m[32m            type="button"[m
[32m+[m[32m            onClick={handleDownloadSchema}[m
[32m+[m[32m            className="flex items-center gap-3 px-6 py-3 bg-[var(--kravy-bg-2)] text-[var(--kravy-text-muted)] rounded-2xl hover:text-indigo-500 transition-all text-[11px] font-black uppercase tracking-widest border border-dashed border-[var(--kravy-border)] hover:border-indigo-500/50 active:scale-95"[m
[32m+[m[32m          >[m
[32m+[m[32m            <Download size={16} />[m
[32m+[m[32m            Format Template[m
[32m+[m[32m          </button>[m
[32m+[m[32m        </div>[m
[32m+[m
[32m+[m[32m        {/* GUIDELINES */}[m
[32m+[m[32m        <div className="grid md:grid-cols-2 gap-4 pt-4 border-t border-[var(--kravy-border)] border-dashed">[m
[32m+[m[32m          <div className="space-y-3 bg-blue-500/5 p-4 rounded-2xl border border-blue-500/10">[m
[32m+[m[32m            <h4 className="text-[10px] font-black text-blue-500 uppercase tracking-widest flex items-center gap-2">[m
[32m+[m[32m              <Info size={12} /> Format Guide[m
[32m+[m[32m            </h4>[m
[32m+[m[32m            <ul className="text-[10px] font-bold text-[var(--kravy-text-muted)] space-y-1 ml-1">[m
[32m+[m[32m              <li>• Key: <code className="text-blue-500">businessName</code> (String, REQUIRED)</li>[m
[32m+[m[32m              <li>• Key: <code className="text-blue-500">state</code> / <code className="text-blue-500">district</code> (Valid Indian names)</li>[m
[32m+[m[32m              <li>• Key: <code className="text-blue-500">upiQrEnabled</code> (Boolean: true/false)</li>[m
[32m+[m[32m              <li>• Key: <code className="text-blue-500">pinCode</code> (String, 6 digits)</li>[m
[32m+[m[32m            </ul>[m
[32m+[m[32m          </div>[m
[32m+[m[32m          <div className="space-y-3 bg-amber-500/5 p-4 rounded-2xl border border-amber-500/10">[m
[32m+[m[32m            <h4 className="text-[10px] font-black text-amber-500 uppercase tracking-widest flex items-center gap-2">[m
[32m+[m[32m              <AlertCircle size={12} /> Conditions[m
[32m+[m[32m            </h4>[m
[32m+[m[32m            <ul className="text-[10px] font-bold text-[var(--kravy-text-muted)] space-y-1 ml-1">[m
[32m+[m[32m              <li>• Image URLs must be from <code className="text-amber-500">cloudinary</code> or <code className="text-amber-500">unsplash</code></li>[m
[32m+[m[32m              <li>• Mandatory fields must not be empty or null</li>[m
[32m+[m[32m              <li>• Invalid JSON will be rejected to prevent data loss</li>[m
[32m+[m[32m            </ul>[m
[32m+[m[32m          </div>[m
[32m+[m[32m        </div>[m
[32m+[m[32m      </div>[m
[32m+[m
[32m+[m[32m      {/* PROPERTY / BUSINESS */}[m
[32m+[m[32m      <Section title="Property & Business Information">[m
[32m+[m[32m        <Field label="Property Type" error={errors.businessType?.message}>[m
[32m+[m[32m          <select[m
[32m+[m[32m            {...register("businessType")}[m
[32m+[m[32m            className="w-full bg-[var(--kravy-input-bg)] border-[var(--kravy-input-border)] text-[var(--kravy-text-primary)] rounded-xl h-11 px-4 focus:ring-2 focus:ring-[var(--kravy-brand)]/20 transition-all outline-none font-bold"[m
[32m+[m[32m          >[m
[32m+[m[32m            <option value="Hotel">Hotel</option>[m
[32m+[m[32m            <option value="Resort">Resort</option>[m
[32m+[m[32m            <option value="Guest House">Guest House</option>[m
[32m+[m[32m            <option value="Boutique Hotel">Boutique Hotel</option>[m
[32m+[m[32m            <option value="Lodge / Motel">Lodge / Motel</option>[m
[32m+[m[32m            <option value="Homestay / Bed & Breakfast">Homestay / Bed & Breakfast</option>[m
[32m+[m[32m            <option value="Hostel">Hostel</option>[m
[32m+[m[32m          </select>[m
[32m+[m[32m        </Field>[m
[32m+[m
[32m+[m[32m        <Field label="Property / Business Name *" error={errors.businessName?.message}>[m
[32m+[m[32m          <Input {...register("businessName")} placeholder="e.g. Kravy Grand Palace" />[m
[32m+[m[32m        </Field>[m
[32m+[m
[32m+[m[32m        <Field label="Tagline / Subtitle" error={errors.businessTagline?.message}>[m
[32m+[m[32m          <Input {...register("businessTagline")} placeholder="e.g. Luxury Stays & Suites" />[m
[32m+[m[32m        </Field>[m
[32m+[m
[32m+[m[32m        <Field label="Invoice Footer Greeting" error={errors.greetingMessage?.message}>[m
[32m+[m[32m          <Input {...register("greetingMessage")} placeholder="Thank you for staying with us!" />[m
[32m+[m[32m        </Field>[m
[32m+[m[32m      </Section>[m
[32m+[m
[32m+[m[32m      {/* CONTACT */}[m
