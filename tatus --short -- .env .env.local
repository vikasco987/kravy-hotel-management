[32m+[m[32m              </div>[m
[32m+[m[32m            )}[m
[32m+[m[32m            <div className="text-center font-bold text-[13px] uppercase tracking-wide">[m
[32m+[m[32m              {watchedValues.businessName || "Kravy Hotel & Suites"}[m
[32m+[m[32m            </div>[m
[32m+[m[32m            {watchedValues.businessTagline && ([m
[32m+[m[32m              <div className="text-center text-[8.5px] italic opacity-80 mt-0.5">[m
[32m+[m[32m                {watchedValues.businessTagline}[m
[32m+[m[32m              </div>[m
[32m+[m[32m            )}[m
[32m+[m
[32m+[m[32m            {(watchedValues.businessAddress || watchedValues.district || selectedState || watchedValues.pinCode || watchedValues.contactPhone) && ([m
[32m+[m[32m              <div className="text-center mt-1 opacity-90 text-[8.5px] leading-tight">[m
[32m+[m[32m                {watchedValues.businessAddress}[m
[32m+[m[32m                {watchedValues.district && `, ${watchedValues.district}`}[m
[32m+[m[32m                {selectedState && `, ${selectedState}`}[m
[32m+[m[32m                {watchedValues.pinCode && ` - ${watchedValues.pinCode}`}[m
[32m+[m[32m                {watchedValues.contactPhone && ([m
[32m+[m[32m                  <div className="mt-0.5">Ph: {watchedValues.contactPhone}</div>[m
[32m+[m[32m                )}[m
[32m+[m[32m              </div>[m
[32m+[m[32m            )}[m
[32m+[m[32m            {watchedValues.gstNumber && ([m
[32m+[m[32m              <div className="text-center text-[8.5px] font-bold mt-0.5">[m
[32m+[m[32m                GSTIN: {watchedValues.gstNumber}[m
[32m+[m[32m              </div>[m
[32m+[m[32m            )}[m
[32m+[m
[32m+[m[32m            <div className="mt-2 border-t border-dashed border-gray-400 pt-1.5 px-0.5">[m
[32m+[m[32m              <div className="flex justify-between items-center mb-1">[m
[32m+[m[32m                <div className="font-black uppercase text-[8px] tracking-wider text-black opacity-80">Guest Folio</div>[m
[32m+[m[32m                <div className="font-bold uppercase text-[7px] bg-black text-white px-1.5 py-0.5 rounded-sm">[m
[32m+[m[32m                  {watchedValues.businessType || "HOTEL"}[m
[32m+[m[32m                </div>[m
[32m+[m[32m              </div>[m
[32m+[m[32m              <div className="text-[8.5px] space-y-0.5">[m
[32m+[m[32m                <div>Guest: <span className="font-bold">Rahul Sharma</span></div>[m
[32m+[m[32m                <div>Room: <span className="font-bold">Deluxe 204 (2 Nights)</span></div>[m
[32m+[m[32m                <div className="text-[7.5px] text-gray-600">[m
[32m+[m[32m                  Stay: {new Date().toLocaleDateString('en-IN')} - 2 Guests[m
[32m+[m[32m                </div>[m
[32m+[m[32m              </div>[m
[32m+[m[32m            </div>[m
[32m+[m
[32m+[m[32m            <div className="my-1.5 border-t border-dashed border-gray-400" />[m
[32m+[m
[32m+[m[32m            <div className="flex justify-between font-semibold text-[8.5px] opacity-90">[m
[32m+[m[32m              <span className="flex-1 pr-1">Particulars</span>[m
[32m+[m[32m              <span className="w-[8mm] text-center shrink-0">Qty</span>[m
[32m+[m[32m              <span className="w-[12mm] text-right shrink-0">Total</span>[m
[32m+[m[32m            </div>[m
[32m+[m
[32m+[m[32m            <div className="border-t border-dashed border-gray-400 my-1" />[m
[32m+[m
[32m+[m[32m            <div className="flex justify-between text-[8.5px] opacity-90 mb-0.5">[m
[32m+[m[32m              <span className="flex-1 truncate pr-1">Room Rent (2 Nights)</span>[m
[32m+[m[32m              <span className="w-[8mm] text-center shrink-0">2</span>[m
[32m+[m[32m              <span className="w-[12mm] text-right shrink-0">5,000.00</span>[m
[32m+[m[32m            </div>[m
[32m+[m[32m            <div className="flex justify-between text-[8.5px] opacity-90 mb-0.5">[m
[32m+[m[32m              <span className="flex-1 truncate pr-1">CGST (6%)</span>[m
[32m+[m[32m              <span className="w-[8mm] text-center shrink-0">-</span>[m
[32m+[m[32m              <span className="w-[12mm] text-right shrink-0">300.00</span>[m
[32m+[m[32m            </div>[m
[32m+[m[32m            <div className="flex justify-between text-[8.5px] opacity-90 mb-0.5">[m
[32m+[m[32m              <span className="flex-1 truncate pr-1">SGST (6%)</span>[m
[32m+[m[32m              <span className="w-[8mm] text-center shrink-0">-</span>[m
[32m+[m[32m              <span className="w-[12mm] text-right shrink-0">300.00</span>[m
[32m+[m[32m            </div>[m
[32m+[m
[32m+[m[32m            <div className="border-t border-dashed border-gray-400 my-1.5" />[m
[32m+[m
[32m+[m[32m            <div className="flex justify-between font-bold text-[10px]">[m
[32m+[m[32m              <span>NET PAYABLE</span>[m
[32m+[m[32m              <span>₹5,600.00</span>[m
[32m+[m[32m            </div>[m
[32m+[m
[32m+[m[32m            <div className="border-t border-dashed border-gray-400 my-1.5" />[m
[32m+[m
[32m+[m[32m            {(watchedValues.upi && watchedValues.upiQrEnabled !== false) && ([m
[32m+[m[32m              <div className="my-2 text-center">[m
[32m+[m[32m                <div className="text-[7.5px] font-bold mb-1">SCAN TO PAY (FRONT DESK)</div>[m
[32m+[m[32m                <div className="inline-block border border-gray-300 p-1 rounded-md bg-white">[m
[32m+[m[32m                  <img[m
[32m+[m[32m                    src={`https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(`upi://pay?pa=${watchedValues.upi}&pn=${watchedValues.businessName || "Hotel"}&am=5600.00&cu=INR`)}`}[m
[32m+[m[32m                    alt="UPI QR"[m
[32m+[m[32m                    className="w-[24mm] h-[24mm] object-contain block mix-blend-multiply"[m
[32m+[m[32m                  />[m
[32m+[m[32m                </div>[m
[32m+[m[32m                <div className="text-center text-[7.5px] mt-1 opacity-90">UPI: {watchedValues.upi}</div>[m
[32m+[m[32m              </div>[m
[32m+[m[32m            )}[m
[32m+[m
[32m+[m[32m            <div className="text-center font-semibold mt-2 opacity-90 text-[8.5px] whitespace-pre-wrap">[m
[32m+[m[32m              {watchedValues.greetingMessage || "Thank you for staying with us!"}[m
[32m+[m[32m            </div>[m
[32m+[m
[32m+[m[32m            {signaturePreview && ([m
[32m+[m[32m              <div className="mt-3 pt-1 border-t border-dotted border-gray-300 text-right">[m
[32m+[m[32m                <div className="flex justify-end">[m
[32m+[m[32m                  <img src={signaturePreview} alt="Signature" className="h-6 object-contain" />[m
[32m+[m[32m                </div>[m
[32m+[m[32m                <div className="text-[7px] text-gray-500 uppercase mt-0.5">Authorized Signatory</div>[m
[32m+[m[32m              </div>[m
[32m+[m[32m            )}[m
[32m+[m
[32m+[m[32m            <div className="h-[8mm] border-t border-dashed border-gray-200 mt-2" />[m
[32m+[m[32m          </div>[m
[32m+[m[32m        </div>[m
[32m+[m[32m      </div>[m
[32m+[m[32m    </div>[m
[32m+[m
[32m+[m[32m  </div>[m
[32m+[m[32m  );[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* ---------------- SMALL UI HELPERS ---------------- */[m
[32m+[m
[32m+[m[32mfunction Section({ title, children }: any) {[m
[32m+[m[32m  return ([m
[32m+[m[32m    <Card className="rounded-[32px] border-[var(--kravy-border)] bg-[var(--kravy-surface)] shadow-2xl overflow-hidden">[m
[32m+[m[32m      <CardHeader className="border-b border-[var(--kravy-border)] bg-[var(--kravy-bg-2)]/50">[m
[32m+[m[32m        <CardTitle className="text-lg font-black text-[var(--kravy-text-primary)] tracking-tight uppercase tracking-widest text-[10px] opacity-70">{title}</CardTitle>[m
[32m+[m[32m      </CardHeader>[m
[32m+[m[32m      <CardContent className="grid md:grid-cols-2 gap-6 p-8">[m
[32m+[m[32m        {children}[m
[32m+[m[32m      </CardContent>[m
[32m+[m[32m    </Card>[m
[32m+[m[32m  );[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction Field({ label, error, children }: { label: string; error?: string; children: React.ReactNode }) {[m
[32m+[m[32m  return ([m
[32m+[m[32m    <div className="space-y-1.5">[m
[32m+[m[32m      <div className="flex justify-between items-center ml-1">[m
[32m+[m[32m        <Label className="text-[10px] font-black text-[var(--kravy-text-muted)] uppercase tracking-widest">{label}</Label>[m
[32m+[m[32m        {error && <span className="text-[10px] font-bold text-rose-500">{error}</span>}[m
[32m+[m[32m      </div>[m
[32m+[m[32m      {children}[m
[32m+[m[32m    </div>[m
[32m+[m[32m  );[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction DragDrop({ id, label, preview, setPreview }: any) {[m
[32m+[m[32m  const [isDragging, setIsDragging] = useState(false);[m
[32m+[m
[32m+[m[32m  const handleDragOver = (e: React.DragEvent) => {[m
[32m+[m[32m    e.preventDefault();[m
[32m+[m[32m    setIsDragging(true);[m
[32m+[m[32m  };[m
[32m+[m
[32m+[m[32m  const handleDragLeave = (e: React.DragEvent) => {[m
[32m+[m[32m    e.preventDefault();[m
[32m+[m[32m    setIsDragging(false);[m
[32m+[m[32m  };[m
[32m+[m
[32m+[m[32m  const handleDrop = (e: React.DragEvent) => {[m
[32m+[m[32m    e.preventDefault();[m
[32m+[m[32m    setIsDragging(false);[m
[32m+[m[32m    if (e.dataTransfer.files?.[0]) {[m
[32m+[m[32m      const file = e.dataTransfer.files[0];[m
[32m+[m[32m      setPreview(URL.createObjectURL(file));[m
[32m+[m[32m      const input = document.getElementById(id) as HTMLInputElement;[m
[32m+[m[32m      if (input) {[m
[32m+[m[32m        input.files = e.dataTransfer.files;[m
[32m+[m[32m      }[m
[32m+[m[32m    }[m
[32m+[m[32m  };[m
[32m+[m
[32m+[m[32m  const handleRemove = (e: React.MouseEvent) => {[m
[32m+[m[32m    e.preventDefault();[m
[32m+[m[32m    e.stopPropagation();[m
[32m+[m[32m    setPreview(null);[m
[32m+[m[32m    const input = document.getElementById(id) as HTMLInputElement;[m
[32m+[m[32m    if (input) {[m
[32m+[m[32m      input.value = "";[m
[32m+[m[32m    }[m
[32m+[m[32m  };[m
[32m+[m
[32m+[m[32m  return ([m
[32m+[m[32m    <label[m
[32m+[m[32m      onDragOver={handleDragOver}[m
[32m+[m[32m      onDragLeave={handleDragLeave}[m
[32m+[m[32m      onDrop={handleDrop}[m
[32m+[m[32m      className={`relative block group border-2 border-dashed rounded-2xl p-6 text-center cursor-pointer transition-all ${isDragging ? 'border-indigo-500 bg-[var(--kravy-surface-hover)]' : 'border-[var(--kravy-border)] hover:bg-[var(--kravy-surface-hover)] hover:border-indigo-500/50'}`}[m
[32m+[m[32m    >[m
[32m+[m[32m      <input[m
[32m+[m[32m        id={id}[m
[32m+[m[32m        type="file"[m
[32m+[m[32m        hidden[m
[32m+[m[32m        onChange={(e) =>[m
[32m+[m[32m          setPreview([m
[32m+[m[32m            e.target.files?.[0][m
[32m+[m[32m              ? URL.createObjectURL(e.target.files[0])[m
[32m+[m[32m              : null[m
[32m+[m[32m          )[m
[32m+[m[32m        }[m
[32m+[m[32m      />[m
[32m+[m[32m      {preview ? ([m
[32m+[m[32m        <div className="relative group/image inline-block">[m
